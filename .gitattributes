# Normalize line endings to LF in the repo and in every working tree
* text=auto eol=lf

# Shell scripts must always be LF
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.mp3 binary
*.mp4 binary
*.webm binary
*.pdf binary
*.zip binary
